# Copiá este archivo como ".env" y completá tus claves.
# El .env real NO se sube al repo (está en .gitignore).

# Proveedor que usa AsyncLLMManager por defecto: "gemini", "openai" o "anthropic"
LLM_PROVIDER=gemini

# Claves de API (solo hace falta la del proveedor que vayas a usar)
GOOGLE_API_KEY=tu-clave-de-google-ai-studio
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Opcionales: modelo por proveedor
GEMINI_MODEL=gemini-flash-lite-latest
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Opcionales: robustez
LLM_TIMEOUT=30
LLM_MAX_RETRIES=2
