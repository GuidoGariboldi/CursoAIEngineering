# Clave de Gemini (gratis en aistudio.google.com)
GOOGLE_API_KEY=tu_clave_de_gemini

# Infraestructura (con Docker Compose se reemplazan solas)
REDIS_URL=redis://localhost:6379
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT_NAME=intelligence-system

# Modelos: el primero es el principal y los demás son respaldos
MODELOS_SUPERVISOR=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-flash-lite-latest
MODELOS_ESPECIALISTAS=gemini-3.5-flash,gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
LLM_TIMEOUT=60

# RAG
EMBEDDINGS_MODEL=intfloat/multilingual-e5-small
CONOCIMIENTO_DIR=conocimiento
CHROMA_DIR=vectorstore
CHROMA_COLLECTION=conocimiento_tienda
RAG_TOP_K=4
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_PESO_BM25=0.5

# Agentes y API
MAX_PASOS_SUPERVISOR=8
RECURSION_LIMIT_ESPECIALISTA=10
RECURSION_LIMIT_GRAFO=30
MAX_MENSAJES_HISTORIAL=10
PAUSA_ENTRE_NODOS=4
WORKERS=2
JOB_TTL_SEGUNDOS=86400
